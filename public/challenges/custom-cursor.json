{
  "id": "custom-cursor",
  "title": "Custom Cursor với Framer Motion",
  "domain": "animation-interaction",
  "subcategory": "custom-cursor",
  "difficulty": "Mid",
  "demoComponentKey": "CustomCursorDemo",
  "statement": "Tạo custom cursor bám theo chuột bằng Framer Motion. Cursor phải có độ trễ mượt (spring), phóng to khi hover vào tiêu đề và snap về giữa màn hình trong lúc hover.",
  "constraints": [
    "Không dùng setInterval hoặc requestAnimationFrame thủ công cho tracking.",
    "Sử dụng motion values + spring để làm mượt chuyển động.",
    "Khi hover, cursor phải tăng kích thước và trở về size mặc định khi rời hover.",
    "Tránh re-render liên tục (ưu tiên motion values)."
  ],
  "complexity": "Time: O(1) mỗi event, Space: O(1)",
  "code": [
    {
      "language": "tsx",
      "content": [
        "\"use client\";",
        "",
        "import {",
        "  motion,",
        "  useMotionValue,",
        "  useSpring,",
        "  useTransform,",
        "  animate,",
        "} from \"framer-motion\";",
        "import { PointerEventHandler, useCallback, useEffect, useState } from \"react\";",
        "",
        "export default function Page() {",
        "  // Target position (vw/vh units, 0-100)",
        "  const targetX = useMotionValue(50);",
        "  const targetY = useMotionValue(50);",
        "",
        "  // Smoothed position",
        "  const springConfig = { stiffness: 150, damping: 5, mass: 0.1 };",
        "  const cursorX = useSpring(targetX, springConfig);",
        "  const cursorY = useSpring(targetY, springConfig);",
        "",
        "  // Transform to CSS string với vw/vh",
        "  const left = useTransform(cursorX, (v) => `${v}vw`);",
        "  const top = useTransform(cursorY, (v) => `${v}vh`);",
        "",
        "  // Cursor size (px)",
        "  const cursorW = useMotionValue(20);",
        "  const cursorH = useMotionValue(20);",
        "",
        "  const sizeSpringConfig = { stiffness: 200, damping: 10 };",
        "  const smoothW = useSpring(cursorW, sizeSpringConfig);",
        "  const smoothH = useSpring(cursorH, sizeSpringConfig);",
        "",
        "  // Border radius",
        "  const borderRadius = useMotionValue(5);",
        "  const smoothRadius = useSpring(borderRadius, sizeSpringConfig);",
        "  const radiusStr = useTransform(smoothRadius, (v) => `${v}%`);",
        "",
        "  // Snap state",
        "  const [isSnapped, setIsSnapped] = useState(false);",
        "",
        "  // Track mouse position",
        "  useEffect(() => {",
        "    const handleMouseMove = (event: MouseEvent) => {",
        "      if (isSnapped) return;",
        "",
        "      const { innerWidth, innerHeight } = window;",
        "      const x = (event.clientX * 100) / innerWidth;",
        "      const y = (event.clientY * 100) / innerHeight;",
        "",
        "      targetX.set(x);",
        "      targetY.set(y);",
        "    };",
        "",
        "    window.addEventListener(\"mousemove\", handleMouseMove);",
        "    return () => window.removeEventListener(\"mousemove\", handleMouseMove);",
        "  }, [isSnapped, targetX, targetY]);",
        "",
        "  const onPointerEnter = useCallback<PointerEventHandler<HTMLHeadingElement>>(",
        "    (event) => {",
        "      const rect = event.currentTarget.getBoundingClientRect();",
        "",
        "      setIsSnapped(true);",
        "",
        "      // Snap to center",
        "      animate(cursorX, 50, { type: \"spring\", stiffness: 200, damping: 20 });",
        "      animate(cursorY, 50, { type: \"spring\", stiffness: 200, damping: 20 });",
        "",
        "      // Expand size & change shape",
        "      cursorW.set(rect.width + 20);",
        "      cursorH.set(rect.height + 10);",
        "    },",
        "    [cursorX, cursorY, cursorW, cursorH]",
        "  );",
        "",
        "  const onPointerLeave = useCallback(() => {",
        "    setIsSnapped(false);",
        "",
        "    // Reset",
        "    cursorW.set(20);",
        "    cursorH.set(20);",
        "    borderRadius.set(10);",
        "  }, [cursorW, cursorH, borderRadius]);",
        "",
        "  return (",
        "    <div className=\"w-screen h-screen bg-black text-green-400 flex items-center justify-center cursor-none\">",
        "      <h1",
        "        onPointerEnter={onPointerEnter}",
        "        onPointerLeave={onPointerLeave}",
        "        className=\"uppercase text-[10vh] leading-none relative cursor-none pl-[0.1em] opacity-60 hover:opacity-100 transition-opacity duration-300\"",
        "      >",
        "        Start",
        "      </h1>",
        "",
        "      {/* Custom Cursor */}",
        "      <motion.div",
        "        className=\"fixed top-0 left-0 pointer-events-none z-50 border-2 border-green-400 mix-blend-difference\"",
        "        style={{",
        "          left,",
        "          top,",
        "          width: smoothW,",
        "          height: smoothH,",
        "          borderRadius: radiusStr,",
        "          x: \"-50%\",",
        "          y: \"-50%\",",
        "        }}",
        "      />",
        "    </div>",
        "  );",
        "}"
      ]
    }
  ],
  "commonMistakes": [
    "Dùng state cho tọa độ cursor khiến re-render liên tục.",
    "Quên cleanup event listener trong useEffect.",
    "Dùng px trực tiếp cho transform vị trí trong khi xử lý vw/vh.",
    "Không reset size/radius khi rời hover.",
    "Pointer events làm cursor bị block hover nếu không đặt pointer-events-none."
  ]
}
